<?php
/**
 * PHPStan stubs for Convoca\Core symbols used by convoca-gateway.
 *
 * convoca-core is a separate plugin that is NOT present in an isolated CI
 * checkout, so PHPStan resolves those symbols against these local stubs
 * instead of scanning ../convoca-core (autosuficiente config).
 */

namespace Convoca\Core;

class Upgrade_Manager
{
    public function init(): void {}
    public function maybe_upgrade(): void {}
    public function force_version_check(): void {}
    protected function run_upgrades( string $from, string $to ): void {}
    protected function run_data_migration( callable $callback, string $description ): void {}
    protected function update_db_version( string $version ): void {}
    protected function get_saved_version(): string { return '0.0.0'; }
    protected function is_cached(): bool { return false; }
    protected function set_cache(): void {}
    protected function clear_cache(): void {}
}

class Logger
{
    public static function info( mixed ...$args ): void {}
    public static function error( mixed ...$args ): void {}
    public static function warning( mixed ...$args ): void {}
    public static function log( mixed ...$args ): void {}
    public static function get_logs( mixed ...$args ): mixed { return null; }
}

class Utils
{
    public static function do_action( mixed ...$args ): void {}
}

class License_Manager
{
    public static function has_pro( mixed ...$args ): mixed { return null; }
}
