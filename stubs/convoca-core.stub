<?php
/**
 * PHPStan stubs for Convoca\Core symbols used by convoca-gateway.
 *
 * convoca-core is a separate plugin that is NOT present in an isolated CI
 * checkout, so PHPStan resolves those symbols against these local stubs
 * instead of scanning ../convoca-core (autosuficiente config).
 */

namespace Convoca\Core;

class Upgrade_Manager
{
    public function init(): void {}
    public function maybe_upgrade(): void {}
    public function force_version_check(): void {}
    protected function run_upgrades( string $from, string $to ): void {}
    protected function run_data_migration( callable $callback, string $description ): void {}
    protected function update_db_version( string $version ): void {}
    protected function get_saved_version(): string { return '0.0.0'; }
    protected function is_cached(): bool { return false; }
    protected function set_cache(): void {}
    protected function clear_cache(): void {}
}

class Logger
{
    public static function info( mixed ...$args ): void {}
    public static function error( mixed ...$args ): void {}
    public static function warning( mixed ...$args ): void {}
    public static function log( mixed ...$args ): void {}
    public static function get_logs( mixed ...$args ): mixed { return null; }
}

class Utils
{
    public static function do_action( mixed ...$args ): void {}
    public static function escape_csv_field( string $field ): string { return $field; }
    public static function stream_csv( string $filename, array $headers, iterable $rows ): int { return 0; }
}

class License_Manager
{
    public static function has_pro( mixed ...$args ): mixed { return null; }
}

class Mailer
{
    public static function send( mixed ...$args ): mixed { return true; }
}

namespace Convoca\Core\Admin;

/**
 * Andamiaje de las pantallas de administración del núcleo (convoca-core#16).
 *
 * Las pantallas de este plugin heredan de aquí (o usan el trait): en el CI aislado el núcleo no está
 * a mano, así que sus símbolos se declaran en el stub para que el análisis resuelva la jerarquía.
 */
trait Andamiaje_Admin
{
    abstract protected function ganchos(): array;
    protected function editor_propio(): ?array { return null; }
    protected function nodo_barra(): ?array { return null; }
    public function __construct() {}
    protected function registrar_subpagina( ?string $padre, string $titulo, string $menu, string $capacidad, string $slug, callable $callback ): string { return ''; }
    protected function encolar_estilo_comun(): void {}
    protected function exigir_guardado( string $nonce, string $capacidad, string $mensaje ): void {}
    public function redirigir_editor_propio(): void {}
    public static function redirigir_pantallas_crudas( array $destinos ): void {}
    public function apuntar_nodo_barra( \WP_Admin_Bar $wp_admin_bar ): void {}
}

abstract class Pantalla_Admin
{
    use Andamiaje_Admin;
}
