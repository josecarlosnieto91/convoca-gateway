{
    "name": "convoca/convoca-gateway",
    "license": "GPL-2.0-or-later",
    "description": "Convoca Plugin",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "wp-coding-standards/wpcs": "^3.1",
        "php-stubs/wordpress-stubs": "^7.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "phpcs": "phpcs --standard=.phpcs.xml.dist --runtime-set ignore_warnings_on_exit 1",
        "phpcbf": "phpcbf --standard=.phpcs.xml.dist",
        "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=4G",
        "phpunit": "phpunit",
        "test": [
            "@phpcs",
            "@phpstan",
            "@phpunit"
        ]
    },
    "autoload": {
        "psr-4": {
            "Convoca\\Gateway\\": [
                "includes/",
                "admin/"
            ]
        }
    }
}
