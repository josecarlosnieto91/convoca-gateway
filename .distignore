# Archivos de desarrollo que NO deben viajar al paquete de WordPress.org
# Nota: vendor/ se excluye del repo dev; el script pack-plugin.py regenera
# vendor --no-dev de PRODUCCIÓN y lo incluye en el zip (wp.org no ejecuta composer).
.git/
.gitignore
.gitattributes
.editorconfig
.github/
.distignore
.phpcs*
.phpunit*
.php-cs-fixer*
phpstan*
phpunit*
composer.lock
node_modules/
dev-tools/
stubs/
tests/
vendor/
*.md
*.xml
*.dist
Makefile
CHANGELOG.md
docs/

# Artefactos de las pruebas de navegador y de PHPUnit: no deben viajar NUNCA.
# `auth.json` es el estado de sesion (cookies de WordPress) y `playwright-report` un
# informe con las trazas. Los dos acabaron servidos por HTTP en sitios reales.
auth.json
storageState.json
playwright-report/
test-results/
.phpunit.result.cache
__pycache__/
