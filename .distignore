# Archivos de desarrollo que NO deben viajar al paquete de WordPress.org
# Nota: vendor/ se excluye del repo dev; el script pack-plugin.py regenera
# vendor --no-dev de PRODUCCIÓN y lo incluye en el zip (wp.org no ejecuta composer).
.git/
.gitignore
.gitattributes
.editorconfig
.github/
.distignore
.phpcs*
.phpunit*
.php-cs-fixer*
phpstan*
phpunit*
composer.lock
node_modules/
dev-tools/
stubs/
tests/
vendor/
*.md
*.xml
*.dist
Makefile
CHANGELOG.md
docs/

# Artefactos de las pruebas de navegador y de PHPUnit: no deben viajar NUNCA.
# `auth.json` es el estado de sesion (cookies de WordPress) y `playwright-report` un
# informe con las trazas. Los dos acabaron servidos por HTTP en sitios reales.
auth.json
storageState.json
playwright-report/
test-results/
.phpunit.result.cache
__pycache__/

# Ficheros de desarrollo que se colaban en el paquete (y por tanto en el sitio).
# Detectados midiendo por HTTP lo que sirve el webroot, no por lo que uno espera ver.
composer.json
package.json
package-lock.json
playwright.config.js
playwright.config.ts
phpunit-unit.xml
phpstan-stubs/
*.stub.php
wpml-config.xml
