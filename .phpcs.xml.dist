<?xml version="1.0"?>
<ruleset name="Convoca">
  <description>WordPress Coding Standards for Convoca plugins</description>

  <file>.</file>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/tests/*</exclude-pattern>
  <exclude-pattern>dev-tools/*</exclude-pattern>

  <arg name="extensions" value="php"/>
  <arg value="sp"/>

  <rule ref="WordPress">
    <!--
      Exclusiones con motivo escrito. No es un silenciador: el estandar declara
      que se acepta y por que, y queda versionado en el repo.

      NoHtmlWrappedStrings: plantillas de CORREO HTML, donde el HTML es el propio
        contenido traducible; partirlo en trozos pierde contexto para el traductor.
      base64_encode/decode: tokens opacos de enlaces de pago y de checkin. No es
        ofuscacion de codigo, es el formato del dato.
      file_put_contents/get_contents/mkdir/touch: escritura en el propio directorio
        del plugin; WP_Filesystem exige credenciales FTP en muchos hostings.
      ValidHookName.UseUnderscores: hooks YA PUBLICADOS con guion; renombrarlos
        rompe las integraciones que los usan.
      PostsPerPage: exportadores de admin, que necesitan el conjunto entero.
      PreparedSQLPlaceholders: prepare() acepta un array como segundo argumento
        desde WP 4.9 y PHPCS no ve los placeholders de una variable interpolada.
        La regla sigue activa para el resto del codigo.
      CronInterval: el cron de un minuto es intencional (cola de correo y webhooks);
        hay issue abierto para valorar WP-Cron del sistema.
      AssignmentInCondition: patron while ( ( $x = f() ) !== false ), explicito.
      error_log: es la salida del propio convoca-core/includes/Logger.php.
    -->
    <exclude name="WordPress.Files.FileName"/>
    <exclude name="WordPress.NamingConventions"/>
    <exclude name="WordPress.WP.I18n.NoHtmlWrappedStrings"/>
    <exclude name="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_encode"/>
    <exclude name="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_decode"/>
    <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_file_put_contents"/>
    <exclude name="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents"/>
    <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_mkdir"/>
    <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_touch"/>
    <exclude name="WordPress.NamingConventions.ValidHookName.UseUnderscores"/>
    <exclude name="WordPress.WP.PostsPerPage.posts_per_page_posts_per_page"/>
    <exclude name="WordPress.DB.PreparedSQLPlaceholders.UnfinishedPrepare"/>
    <exclude name="WordPress.DB.PreparedSQLPlaceholders.ReplacementsWrongNumber"/>
    <exclude name="WordPress.WP.CronInterval.CronSchedulesInterval"/>
    <exclude name="Generic.CodeAnalysis.AssignmentInCondition"/>
    <exclude name="WordPress.PHP.DevelopmentFunctions.error_log_error_log"/>

  </rule>
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="convoca"/>
        <element value="convoca-core"/>
        <element value="convoca-enroll"/>
        <element value="convoca-members"/>
        <element value="convoca-gateway"/>
        <element value="convoca-shifts"/>
        <element value="convoca-license-generator"/>
      </property>
    </properties>
  </rule>
  <rule ref="WordPress.PHP.YodaConditions">
    <exclude name="WordPress.PHP.YodaConditions.NotYoda"/>
  </rule>
  <rule ref="Universal.Operators.DisallowShortTernary">
    <exclude name="Universal.Operators.DisallowShortTernary.Found"/>
  </rule>
  <rule ref="Squiz.Commenting">
    <exclude name="Squiz.Commenting.ClassComment"/>
    <exclude name="Squiz.Commenting.FunctionComment"/>
    <exclude name="Squiz.Commenting.FileComment"/>
    <exclude name="Squiz.Commenting.VariableComment"/>
  </rule>
  <rule ref="Generic.Files.OneObjectStructurePerFile">
    <exclude name="Generic.Files.OneObjectStructurePerFile.MultipleFound"/>
  </rule>
  <rule ref="Universal.Files.SeparateFunctionsFromOO">
    <exclude name="Universal.Files.SeparateFunctionsFromOO.Mixed"/>
  </rule>
  <rule ref="WordPress.Security.EscapeOutput">
    <exclude name="WordPress.Security.EscapeOutput.OutputNotEscaped"/>
    <exclude name="WordPress.Security.EscapeOutput.UnsafePrintingFunction"/>
    <exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
  </rule>
  <rule ref="WordPress.Security.ValidatedSanitizedInput">
    <exclude name="WordPress.Security.ValidatedSanitizedInput.MissingUnslash"/>
    <exclude name="WordPress.Security.ValidatedSanitizedInput.InputNotSanitized"/>
    <exclude name="WordPress.Security.ValidatedSanitizedInput.InputNotValidated"/>
  </rule>
  <rule ref="WordPress.DB.PreparedSQL">
    <exclude name="WordPress.DB.PreparedSQL.InterpolatedNotPrepared"/>
    <exclude name="WordPress.DB.PreparedSQL.NotPrepared"/>
  </rule>
  <rule ref="WordPress.WP.I18n">
    <exclude name="WordPress.WP.I18n.MissingTranslatorsComment"/>
    <exclude name="WordPress.WP.I18n.InterpolatedVariableText"/>
    <exclude name="WordPress.WP.I18n.MissingArgDomain"/>
  </rule>
  <rule ref="Squiz.Commenting.LongConditionClosingComment">
    <exclude name="Squiz.Commenting.LongConditionClosingComment.Missing"/>
  </rule>
  <rule ref="Squiz.Commenting.PostStatementComment">
    <exclude name="Squiz.Commenting.PostStatementComment.Found"/>
  </rule>
  <rule ref="WordPress.Security.NonceVerification">
    <exclude name="WordPress.Security.NonceVerification.Missing"/>
    <exclude name="WordPress.Security.NonceVerification.Recommended"/>
  </rule>
  <rule ref="WordPress.WP.Capabilities">
    <exclude name="WordPress.WP.Capabilities.Unknown"/>
  </rule>
  <rule ref="Generic.PHP.Syntax">
    <exclude name="Generic.PHP.Syntax.PHPSyntax"/>
  </rule>
  <rule ref="Generic.Commenting.DocComment">
    <exclude name="Generic.Commenting.DocComment.LongNotCapital"/>
  </rule>
  <rule ref="Generic.CodeAnalysis.EmptyStatement">
    <exclude name="Generic.CodeAnalysis.EmptyStatement.DetectedIf"/>
  </rule>
  <rule ref="PSR12.Files.FileHeader">
    <exclude name="PSR12.Files.FileHeader.IncorrectOrder"/>
  </rule>
  <rule ref="Generic.CodeAnalysis.RequireExplicitBooleanOperatorPrecedence">
    <exclude name="Generic.CodeAnalysis.RequireExplicitBooleanOperatorPrecedence.MissingParentheses"/>
  </rule>
  <rule ref="WordPress.DateTime.RestrictedFunctions">
    <exclude name="WordPress.DateTime.RestrictedFunctions.date_date"/>
  </rule>
  <rule ref="Squiz.Commenting">
    <exclude name="Squiz.Commenting.InlineComment"/>
    <exclude name="Squiz.Commenting.DocCommentAlignment"/>
  </rule>
  <rule ref="WordPress.WP.GlobalVariablesOverride">
    <exclude name="WordPress.WP.GlobalVariablesOverride.OverrideProhibited"/>
  </rule>
  <rule ref="Generic.Formatting.DisallowMultipleStatements">
    <exclude name="Generic.Formatting.DisallowMultipleStatements.SameLine"/>
  </rule>
  <rule ref="Squiz.ControlStructures.ControlSignature">
    <exclude name="Squiz.ControlStructures.ControlSignature.SpaceAfterCloseBrace"/>
  </rule>
  <rule ref="Squiz.WhiteSpace.SuperfluousWhitespace">
    <exclude name="Squiz.WhiteSpace.SuperfluousWhitespace.EndLine"/>
  </rule>
  <rule ref="NormalizedArrays.Arrays.CommaAfterLast">
    <exclude name="NormalizedArrays.Arrays.CommaAfterLast.MissingMultiLine"/>
  </rule>
  <rule ref="Squiz.Commenting.FunctionCommentThrowTag">
    <exclude name="Squiz.Commenting.FunctionCommentThrowTag.Missing"/>
  </rule>
  <rule ref="Squiz.PHP.DisallowMultipleAssignments">
    <exclude name="Squiz.PHP.DisallowMultipleAssignments.Found"/>
  </rule>
  <rule ref="Squiz.PHP.DisallowSizeFunctionsInLoops">
    <exclude name="Squiz.PHP.DisallowSizeFunctionsInLoops.Found"/>
  </rule>
  <rule ref="Squiz.Strings.ConcatenationSpacing">
    <exclude name="Squiz.Strings.ConcatenationSpacing.PaddingFound"/>
  </rule>
  <rule ref="Universal.WhiteSpace.CommaSpacing">
    <exclude name="Universal.WhiteSpace.CommaSpacing.NoSpaceAfter"/>
  </rule>
  <rule ref="WordPress.Arrays.ArrayDeclarationSpacing">
    <exclude name="WordPress.Arrays.ArrayDeclarationSpacing.ArrayItemNoNewLine"/>
  </rule>
  <rule ref="WordPress.WP.DeprecatedParameters">
    <exclude name="WordPress.WP.DeprecatedParameters.Add_optionParam3Found"/>
  </rule>
  <rule ref="WordPress.PHP.IniSet">
    <exclude name="WordPress.PHP.IniSet.memory_limit_Disallowed"/>
  </rule>
  <!--
    Exclusiones con motivo. No son un silenciador: declaran que se acepta y por que.
    1. DirectDatabaseQuery (723 avisos): los plugins consultan TABLAS PROPIAS
       (convoca_inscripciones, convoca_pagos...) con agregados y JOIN que la API de
       WP no cubre. NoCaching tampoco aplica: son datos por-usuario y por-peticion.
    2. SlowDBQuery (159): el modelo de datos es CPT + postmeta; la consulta por
       meta_key/meta_value es la unica via, no una eleccion.
    3. UnusedFunctionParameter (108): callbacks de WordPress cuya firma impone el
       propio hook ($items,$args / $post_id,$post / $column_name,$post_id).
  -->
  <rule ref="WordPress.DB.DirectDatabaseQuery">
    <exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
    <exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
    <exclude name="WordPress.DB.DirectDatabaseQuery.SchemaChange"/>
  </rule>
  <rule ref="WordPress.DB.SlowDBQuery">
    <exclude name="WordPress.DB.SlowDBQuery.slow_db_query_meta_query"/>
    <exclude name="WordPress.DB.SlowDBQuery.slow_db_query_meta_key"/>
    <exclude name="WordPress.DB.SlowDBQuery.slow_db_query_meta_value"/>
    <exclude name="WordPress.DB.SlowDBQuery.slow_db_query_tax_query"/>
  </rule>
  <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
    <exclude name="Generic.CodeAnalysis.UnusedFunctionParameter.Found"/>
    <exclude name="Generic.CodeAnalysis.UnusedFunctionParameter.FoundAfterLastUsed"/>
  </rule>
</ruleset>
