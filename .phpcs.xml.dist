<?xml version="1.0"?>
<ruleset ref="../convoca-core/dev-tools/phpcs.xml.dist">
  <description>Convoca (inherited from convoca-core)</description>
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="convoca-gateway"/>
      </property>
    </properties>
  </rule>
</ruleset>
