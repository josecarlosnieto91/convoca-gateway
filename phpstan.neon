includes:
    # - phpstan-baseline.neon (temporal)

parameters:
    level: 5
    paths:
        - admin
        - includes
        - convoca-gateway.php
    excludePaths:
        analyseAndScan:
            - vendor
            - tests
            - dev-tools
            - node_modules (?)
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - phpstan-bootstrap.php
    scanFiles:
        - stubs/convoca-core.stub
    ignoreErrors:
        # ── Falsos positivos del harness de análisis (NO deuda de código) ──
        # ABSPATH=/tmp/wp/ no existe fuera de un WP real; los require_once de
        # wp-admin son legítimos en runtime (WP_List_Table, screen, file).
        -
            message: '#Path in require_once\(\) "/tmp/wp/wp-admin/#'
            identifier: requireOnce.fileNotFound
        # add_submenu_page(null) es el patrón WP documentado para páginas
        # standalone accesibles vía admin.php?page=.
        -
            message: '#Parameter \#1 \$parent_slug of function add_submenu_page expects string, null given#'
            identifier: argument.type
        # wp_dropdown_pages: option_none_value=0 es válido (el stub no lista
        # la key como opcional con int; WP lo acepta).
        -
            message: '#Parameter \#1 \$args of function wp_dropdown_pages#'
            identifier: argument.type
            path: includes/Admin_Settings.php
        # check_admin_referer() hace wp_die si el nonce falla: stub reciente lo
        # tipa como siempre-true. Patrón WP estándar en admin handlers.
        -
            message: '#Right side of && is always true#'
            identifier: booleanAnd.rightAlwaysTrue
        # Admin_Payments:66 — if(check_admin_referer()) siempre true por stub.
        -
            message: '#If condition is always true#'
            identifier: if.alwaysTrue
            path: includes/Admin_Payments.php
        # wp_handle_upload() devuelve array|WP_Error en el stub; el chequeo
        # $movefile && !isset(error) es defensivo correcto en runtime.
        -
            message: '#Left side of && is always true#'
            identifier: booleanAnd.leftAlwaysTrue
            path: includes/Payment_Handler.php

