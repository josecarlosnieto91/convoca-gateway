includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - admin
        - includes
        - convoca-gateway.php
    excludePaths:
        analyseAndScan:
            - vendor
            - tests
            - dev-tools
            - node_modules (?)
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - phpstan-bootstrap.php
    scanFiles:
        - stubs/convoca-core.stub
